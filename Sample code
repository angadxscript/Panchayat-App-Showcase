// screens/LoginScreen.js

import React, { useRef, useState } from "react";
import {
  View,
  Text,
  TextInput,
  TouchableOpacity,
  StyleSheet,
  ActivityIndicator,
  KeyboardAvoidingView,
  Platform,
  ScrollView,
  Alert,
} from "react-native";

import { useRouter } from "expo-router";
import { signInWithEmailAndPassword } from "firebase/auth";
import { collection, query, where, getDocs } from "firebase/firestore";
import AsyncStorage from "@react-native-async-storage/async-storage";
import { Ionicons } from "@expo/vector-icons";

import { auth, db } from "../firebaseConfig";

export default function Login() {
  const router = useRouter();

  const passwordRef = useRef(null);

  const [selectedRole, setSelectedRole] = useState("tenant");
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");

  const [loading, setLoading] = useState(false);
  const [showPassword, setShowPassword] = useState(false);
  const [emailValid, setEmailValid] = useState(true);

  const validateEmail = (text) => {
    setEmail(text);

    if (!text.trim()) {
      setEmailValid(true);
      return;
    }

    const regex = /\S+@\S+\.\S+/;
    setEmailValid(regex.test(text));
  };

  const isFormValid = email.trim() && password.trim() && emailValid;

  const handleLogin = async () => {
    if (loading) return;

    if (!email.trim() || !password.trim()) {
      Alert.alert("Missing Details", "Please enter email and password.");
      return;
    }

    if (!emailValid) {
      Alert.alert("Invalid Email", "Enter a valid email address.");
      return;
    }

    setLoading(true);

    try {
      const userCredential = await signInWithEmailAndPassword(
        auth,
        email.trim().toLowerCase(),
        password
      );

      const uid = userCredential.user.uid;

      const userQuery = query(
        collection(db, "users"),
        where("authUserId", "==", uid)
      );

      const snapshot = await getDocs(userQuery);

      if (snapshot.empty) {
        Alert.alert("Error", "User profile not found in database.");
        setLoading(false);
        return;
      }

      const userDoc = snapshot.docs[0];
      const userData = userDoc.data();

      const role = userData.role?.trim().toLowerCase();
      const selected = selectedRole.trim().toLowerCase();

      if (role !== selected) {
        Alert.alert(
          "Wrong Login Type",
          `This account is registered as ${userData.role}. Please select ${userData.role} login.`
        );
        setLoading(false);
        return;
      }

      const activePgId = userData.activePgId || userData.pgId || "";

      await AsyncStorage.setItem("userLoggedIn", "true");
      await AsyncStorage.setItem("userUID", uid);
      await AsyncStorage.setItem("userDocId", userDoc.id);
      await AsyncStorage.setItem("userRole", role);
      await AsyncStorage.setItem("role", role);

      if (activePgId) {
        await AsyncStorage.setItem("pgId", activePgId);
        await AsyncStorage.setItem("activePgId", activePgId);
      } else {
        await AsyncStorage.removeItem("pgId");
        await AsyncStorage.removeItem("activePgId");
      }

      if (userData.pgName) {
        await AsyncStorage.setItem("pgName", userData.pgName);
      } else {
        await AsyncStorage.removeItem("pgName");
      }

      if (userData.pgThemeColor) {
        await AsyncStorage.setItem("pgThemeColor", userData.pgThemeColor);
      } else {
        await AsyncStorage.removeItem("pgThemeColor");
      }

      if (role === "owner") {
        if (activePgId) {
          router.replace("/owner");
        } else {
          router.replace("/createPG");
        }
      } else {
        if (activePgId) {
          router.replace("/(tabs)");
        } else {
          Alert.alert(
            "PG Not Linked",
            "Your tenant account is not connected to any PG. Please contact your PG owner for the correct access code."
          );
        }
      }
    } catch (error) {
      console.log("LOGIN ERROR:", error);
      Alert.alert("Login Failed", "Invalid email or password.");
    } finally {
      setLoading(false);
    }
  };

  return (
    <KeyboardAvoidingView
      style={styles.safe}
      behavior={Platform.OS === "ios" ? "padding" : "height"}
    >
      <ScrollView
        contentContainerStyle={styles.container}
        keyboardShouldPersistTaps="handled"
        showsVerticalScrollIndicator={false}
      >
        <View style={styles.card}>
          <View style={styles.headerIcon}>
            <Ionicons name="home" size={24} color="#2563EB" />
          </View>

          <Text style={styles.title}>Welcome Back</Text>

          <Text style={styles.subtitle}>
            {selectedRole === "tenant"
              ? "Login to manage your PG life"
              : "Login to manage your PG business"}
          </Text>

          <Text style={styles.label}>Login Type</Text>

          <View style={styles.roleContainer}>
            <TouchableOpacity
              activeOpacity={0.85}
              style={[
                styles.roleButton,
                selectedRole === "tenant" && styles.activeRole,
              ]}
              onPress={() => setSelectedRole("tenant")}
            >
              <Ionicons
                name="person-outline"
                size={17}
                color={selectedRole === "tenant" ? "#FFFFFF" : "#64748B"}
              />

              <Text
                style={[
                  styles.roleText,
                  selectedRole === "tenant" && styles.activeRoleText,
                ]}
              >
                Tenant
              </Text>
            </TouchableOpacity>

            <TouchableOpacity
              activeOpacity={0.85}
              style={[
                styles.roleButton,
                selectedRole === "owner" && styles.activeRole,
              ]}
              onPress={() => setSelectedRole("owner")}
            >
              <Ionicons
                name="business-outline"
                size={17}
                color={selectedRole === "owner" ? "#FFFFFF" : "#64748B"}
              />

              <Text
                style={[
                  styles.roleText,
                  selectedRole === "owner" && styles.activeRoleText,
                ]}
              >
                Owner
              </Text>
            </TouchableOpacity>
          </View>

          <Text style={styles.label}>Email</Text>

          <TextInput
            placeholder="e.g. angad@gmail.com"
            placeholderTextColor="#94A3B8"
            style={[styles.input, !emailValid && styles.inputError]}
            value={email}
            onChangeText={validateEmail}
            keyboardType="email-address"
            autoCapitalize="none"
            returnKeyType="next"
            onSubmitEditing={() => passwordRef.current?.focus()}
          />

          {!emailValid && <Text style={styles.error}>Invalid email</Text>}

          <Text style={styles.label}>Password</Text>

          <View style={styles.passwordRow}>
            <TextInput
              ref={passwordRef}
              placeholder="Enter password"
              placeholderTextColor="#94A3B8"
              secureTextEntry={!showPassword}
              style={styles.passwordInput}
              value={password}
              onChangeText={setPassword}
              returnKeyType="done"
              onSubmitEditing={handleLogin}
            />

            <TouchableOpacity
              activeOpacity={0.8}
              onPress={() => setShowPassword(!showPassword)}
            >
              <Ionicons
                name={showPassword ? "eye" : "eye-off"}
                size={22}
                color="#64748B"
              />
            </TouchableOpacity>
          </View>

          <TouchableOpacity
            activeOpacity={0.9}
            style={[styles.button, (!isFormValid || loading) && styles.disabledButton]}
            onPress={handleLogin}
            disabled={!isFormValid || loading}
          >
            {loading ? (
              <ActivityIndicator color="#FFFFFF" />
            ) : (
              <Text style={styles.buttonText}>
                Login as {selectedRole === "owner" ? "Owner" : "Tenant"}
              </Text>
            )}
          </TouchableOpacity>

          <TouchableOpacity onPress={() => router.push("/signup")}>
            <Text style={styles.link}>
              Don’t have an account? <Text style={styles.bold}>Sign Up</Text>
            </Text>
          </TouchableOpacity>
        </View>
      </ScrollView>
    </KeyboardAvoidingView>
  );
}

